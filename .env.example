# Skopiuj do .env i uzupełnij. Pliku .env nie commituj.

# min. 32 znaki, np. wynik: openssl rand -base64 48
FORMBRIDGE_JWT_SECRET=
FORMBRIDGE_CLIENT_ID=coi
FORMBRIDGE_CLIENT_SECRET=

FORMBRIDGE_SECURITY_ENABLED=true
FORMBRIDGE_UPLOAD_MAX_FILE_SIZE=20MB
# model językowy jest opcjonalny: włącz go i uruchom: docker compose --profile llm up --build
FORMBRIDGE_LLM_ENABLED=false
FORMBRIDGE_LLM_TIMEOUT=45s

# liczba rdzeni dla modelu językowego
LLM_THREADS=6
